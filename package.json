{
  "name": "@a-mdui/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for A-MarkdownUI (.mdui) generative UI rendering in Antigravity IDE",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "amdui-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/assets',{recursive:true});if(fs.existsSync('../../dist/a-mdui.bundle.js')){fs.copyFileSync('../../dist/a-mdui.bundle.js','dist/assets/a-mdui.bundle.js');fs.copyFileSync('../../dist/a-mdui.bundle.css','dist/assets/a-mdui.bundle.css');}\"",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antigravity",
    "markdown-ui",
    "generative-ui",
    "mdui"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anandsankarank/MD2UI.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}

